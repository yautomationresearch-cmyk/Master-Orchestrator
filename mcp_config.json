{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "agentation": {
      "command": "npx",
      "args": [
        "-y",
        "agentation-mcp@latest"
      ]
    },
    "21st": {
      "url": "https://21st.dev/api/mcp"
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn-mcp@latest"
      ]
    },
    "reactbits": {
      "command": "npx",
      "args": [
        "-y",
        "reactbits-mcp@latest"
      ]
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server@latest"
      ]
    }
  }
}