{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // Babel loads plugins with require(), so this package emits CommonJS — then a standard CJS
    // babel.config.js can require() it on ANY Node version, with no require(esm) dependency. It has
    // zero runtime deps and imports only node:path, so CJS is clean.
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "verbatimModuleSyntax": false,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
